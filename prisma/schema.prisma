generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime da app: conexão via pooler do Neon (PgBouncer, modo transaction).
  url       = env("DATABASE_URL")
  // Migrations (prisma migrate/db push): conexão DIRETA, sem pooler — o
  // PgBouncer em modo transaction não suporta os comandos de migração.
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String                 @id @default(cuid())
  email                String                 @unique
  name                 String
  passwordHash         String                 @map("password_hash")
  phone                String?                @unique
  avatarUrl            String?                @map("avatar_url")
  onboardedAt          DateTime?              @map("onboarded_at")
  // Null = email ainda não confirmado. NÃO bloqueia login (decisão de produto):
  // o app só exibe um banner pedindo confirmação enquanto for null.
  emailVerifiedAt      DateTime?              @map("email_verified_at")
  // Fim do período de teste grátis (7 dias). Setado no sign-up; explícito (não
  // derivado de createdAt) para permitir estender. Hoje o pós-trial é SOFT: ao
  // expirar, só exibe aviso, não bloqueia. O Stripe endurece isso depois.
  trialEndsAt          DateTime?              @map("trial_ends_at")
  twoFactorEnabled     Boolean                @default(false) @map("two_factor_enabled")
  twoFactorSecret      String?                @map("two_factor_secret") // criptografado
  backupCodes          String[]               @default([]) @map("backup_codes") // hasheados (bcrypt)
  // Super-admin da PLATAFORMA (dono), não o papel ADMIN de família. Setado
  // manualmente no banco; protege os endpoints /admin/*. Default false.
  isSuperAdmin         Boolean                @default(false) @map("is_super_admin")
  // Última atividade do usuário (qualquer request autenticado). Atualizado com
  // throttle (no máx 1x a cada 15min) pelo LoggingInterceptor — não é login,
  // é "visto por último". Usado no painel admin p/ ativo vs. abandonado.
  lastSeenAt           DateTime?              @map("last_seen_at")
  // Assinatura (Stripe). Default TRIALING cobre quem cadastrou antes do billing —
  // junto com trialEndsAt já existente. O acesso premium NÃO é lido só daqui: é
  // derivado por hasPremiumAccess() = ACTIVE OU (TRIALING e trialEndsAt no futuro).
  // A fonte da verdade do status é o webhook do Stripe, não a resposta do checkout.
  stripeCustomerId     String?                @unique @map("stripe_customer_id")
  stripeSubscriptionId String?                @unique @map("stripe_subscription_id")
  subscriptionStatus   SubscriptionStatus     @default(TRIALING) @map("subscription_status")
  currentPeriodEnd     DateTime?              @map("current_period_end") // fim do ciclo pago
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  transactions         Transaction[]
  cards                Card[]
  goals                Goal[]
  reserves             Reserve[]
  recurring            RecurringTransaction[]
  invoicePayments      InvoicePayment[]
  budgets              Budget[]
  ownedFamilies        Family[]               @relation("FamilyOwner")
  familyMembers        FamilyMember[]
  verificationCodes    VerificationCode[]
  categories           Category[]
  aiUsage              AiUsage[]
  reminderSetting      ReminderSetting?
  reminderLogs         ReminderLog[]

  @@map("users")
}

// Preferências de mensagens proativas (lembretes + alertas automáticos).
// Ausência de linha = defaults (tudo ligado, 3 dias de antecedência) — só é
// criada quando o usuário mexe nas configurações.
model ReminderSetting {
  id            String  @id @default(cuid())
  userId        String  @unique @map("user_id")
  // Lembretes de vencimento (contas fixas + faturas de cartão).
  billsEnabled  Boolean @default(true) @map("bills_enabled")
  // Antecedência do lembrete de vencimento, em dias (1–7).
  daysBefore    Int     @default(3) @map("days_before")
  // Alertas automáticos já existentes (alerta de gastos, resumo semanal,
  // comparativo mensal, assinaturas, anomalias). Opt-out único: são o mesmo
  // "canal" na percepção do usuário.
  alertsEnabled Boolean @default(true) @map("alerts_enabled")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminder_settings")
}

// Auditoria + idempotência de mensagens proativas: o cron marca o envio ANTES
// de mandar (claim via dedupeKey único) — um restart no horário do cron não
// duplica a mensagem.
model ReminderLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  kind      String // "bill" | "card_invoice" (futuro: "reminder")
  refId     String?  @map("ref_id") // recurringId / cardId
  // Chave natural do envio, ex. "bill:<recurringId>:2026-07-10" (data do
  // vencimento). Única = claim atômico.
  dedupeKey String   @unique @map("dedupe_key")
  sentAt    DateTime @default(now()) @map("sent_at")
  channel   String // "whatsapp"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, sentAt])
  @@map("reminder_logs")
}

enum SubscriptionStatus {
  TRIALING // dentro do trial (ou conta antiga, ainda sem assinatura)
  ACTIVE // assinatura paga em dia
  PAST_DUE // pagamento falhou, em retry pelo Stripe
  CANCELED // cancelada / expirada
}

enum VerificationCodeType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// OTP efêmero para confirmação de email e reset de senha.
// - codeHash: o código (6 dígitos) é guardado HASHEADO (bcrypt), nunca em texto.
// - email: redundante com o user, mas permite emitir reset antes de resolver o
//   userId e serve de índice de busca no fluxo "esqueci a senha".
// - attempts: tentativas erradas; o use-case invalida após 5.
// - consumedAt: marca uso único — um código verificado não vale de novo.
model VerificationCode {
  id         String               @id @default(cuid())
  type       VerificationCodeType
  email      String
  codeHash   String               @map("code_hash")
  expiresAt  DateTime             @map("expires_at")
  attempts   Int                  @default(0)
  consumedAt DateTime?            @map("consumed_at")
  userId     String?              @map("user_id")
  createdAt  DateTime             @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Busca o código ativo mais recente por (email, type) nos dois fluxos.
  @@index([email, type])
  @@index([userId])
  @@map("verification_codes")
}

// Categoria de transação. Dois tipos no mesmo modelo:
// - Sistema (userId = null): as do seed, compartilhadas por todos, read-only.
// - Do usuário (userId preenchido): criadas pelo dono; visíveis/usáveis por toda
//   a família (resolução via FamilyContext, igual ao resto do app).
// O slug é gerado pelo backend a partir do nome e é único por dono
// (@@unique[userId, slug]). icon guarda um emoji.
model Category {
  id           String                 @id @default(cuid())
  name         String
  slug         String
  icon         String?
  colorBg      String                 @map("color_bg")
  colorText    String                 @map("color_text")
  userId       String?                @map("user_id")
  createdAt    DateTime               @default(now()) @map("created_at")
  user         User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  goals        Goal[]
  recurring    RecurringTransaction[]

  @@unique([userId, slug])
  @@index([userId])
  @@map("categories")
}

model Transaction {
  id                 String            @id @default(cuid())
  amount             Decimal           @db.Decimal(12, 2)
  type               TransactionType
  description        String?
  date               DateTime          @default(now())
  source             TransactionSource @default(MANUAL)
  userId             String            @map("user_id")
  categoryId         String            @map("category_id")
  cardId             String?           @map("card_id")
  recurringId        String?           @map("recurring_id")
  // Parcelamento: todas as parcelas de uma mesma compra compartilham o
  // installmentGroupId, permitindo excluir o grupo inteiro de uma vez.
  // Nulo em transações avulsas (e em parcelas criadas antes desta migration).
  installmentGroupId String?           @map("installment_group_id")
  installmentNumber  Int?              @map("installment_number")
  installmentTotal   Int?              @map("installment_total")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       Category              @relation(fields: [categoryId], references: [id])
  card           Card?                 @relation(fields: [cardId], references: [id], onDelete: SetNull)
  recurring      RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  invoicePayment InvoicePayment?

  @@index([userId, date])
  // Breakdown por categoria com filtro/ordenação por data (alerts, chat,
  // dashboard). Inclui o antigo (userId, categoryId) como prefixo.
  @@index([userId, categoryId, date])
  @@index([userId, cardId])
  // Faturas: transações de um cartão por período.
  @@index([cardId, date])
  @@index([recurringId])
  // Excluir/agrupar todas as parcelas de uma mesma compra.
  @@index([installmentGroupId])
  @@map("transactions")
}

// Como ajustar a data quando o dia da recorrência cai em fim de semana ou
// feriado nacional. EXACT = lança no dia cru (comportamento original);
// PREVIOUS = antecipa para o dia útil anterior (típico de salário);
// NEXT = posterga para o dia útil seguinte (típico de alguns boletos).
enum BusinessDayAdjustment {
  EXACT
  PREVIOUS
  NEXT
}

model RecurringTransaction {
  id                    String                @id @default(cuid())
  description           String
  amount                Decimal               @db.Decimal(12, 2)
  type                  TransactionType
  dayOfMonth            Int                   @map("day_of_month")
  businessDayAdjustment BusinessDayAdjustment @default(EXACT) @map("business_day_adjustment")
  active                Boolean               @default(true)
  userId                String                @map("user_id")
  categoryId            String                @map("category_id")
  cardId                String?               @map("card_id")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id])
  card         Card?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId])
  @@map("recurring_transactions")
}

model Card {
  id          String   @id @default(cuid())
  name        String
  brand       String?
  limit       Decimal? @db.Decimal(12, 2)
  closingDay  Int      @map("closing_day")
  dueDay      Int?     @map("due_day")
  // Cor escolhida pelo usuário (chave de preset, ex.: "azul"). Nulo = sem
  // escolha → o visual do cartão cai no tema derivado da bandeira (brand).
  colorPreset String?  @map("color_preset")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  recurring       RecurringTransaction[]
  invoicePayments InvoicePayment[]

  @@index([userId])
  @@map("cards")
}

// Pagamento (total ou parcial) de uma fatura de cartão. Liga o cartão + o ciclo
// de fatura (cycle = "YYYY-MM", o mesmo `month` de getInvoice) à despesa
// fora-cartão gerada na categoria "pagamento-fatura". Um ciclo pode ter vários
// pagamentos (parcial); o status (aberto/parcial/paga) é derivado da soma.
model InvoicePayment {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  cardId        String   @map("card_id")
  cycle         String
  amount        Decimal  @db.Decimal(12, 2)
  paidAt        DateTime @map("paid_at")
  transactionId String?  @unique @map("transaction_id")
  createdAt     DateTime @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  card        Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([cardId, cycle])
  @@map("invoice_payments")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionSource {
  MANUAL
  WHATSAPP
  RECURRING
}

model Family {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner   User           @relation("FamilyOwner", fields: [ownerId], references: [id])
  members FamilyMember[]

  @@map("families")
}

model FamilyMember {
  id       String           @id @default(cuid())
  role     FamilyMemberRole @default(MEMBER)
  joinedAt DateTime         @default(now()) @map("joined_at")
  userId   String           @map("user_id")
  familyId String           @map("family_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
  @@map("family_members")
}

enum FamilyMemberRole {
  OWNER
  ADMIN
  MEMBER
}

model Goal {
  id         String     @id @default(cuid())
  name       String
  amount     Decimal    @db.Decimal(12, 2)
  period     GoalPeriod @default(MONTHLY)
  userId     String     @map("user_id")
  categoryId String     @map("category_id")
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId])
  @@index([userId])
  @@map("goals")
}

enum GoalPeriod {
  MONTHLY
  WEEKLY
}

model Budget {
  id        String   @id @default(cuid())
  month     String // formato 'YYYY-MM'
  amount    Decimal  @db.Decimal(12, 2)
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId])
  @@map("budgets")
}

// Reserva: objetivo de juntar dinheiro (valor-alvo + prazo). É outro conceito
// do model Goal (que é teto de gasto por categoria — exibido como "Metas" no
// app). Os aportes viram transação de DESPESA na categoria "reservas" E
// incrementam savedAmount — savedAmount é a fonte da verdade do progresso
// (sem relação com Transaction).
model Reserve {
  id           String   @id @default(cuid())
  name         String
  targetAmount Decimal  @default(0) @map("target_amount") @db.Decimal(12, 2)
  savedAmount  Decimal  @default(0) @map("saved_amount") @db.Decimal(12, 2)
  deadline     DateTime
  active       Boolean  @default(true)
  userId       String   @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reserves")
}

// Consumo de IA por chamada (chat web e parser do WhatsApp). Uma linha por
// chamada à OpenAI. Permite medir custo por dia/usuário no painel admin.
// costUsd é estimado a partir dos tokens × tabela de preço do modelo (no código).
enum AiFeature {
  CHAT
  WHATSAPP_PARSER
  WHATSAPP_TRANSCRIPTION
  WHATSAPP_RECEIPT
}

model AiUsage {
  id               String    @id @default(cuid())
  userId           String?   @map("user_id") // null se não resolvido
  feature          AiFeature
  model            String
  promptTokens     Int       @map("prompt_tokens")
  completionTokens Int       @map("completion_tokens")
  totalTokens      Int       @map("total_tokens")
  costUsd          Decimal   @default(0) @map("cost_usd") @db.Decimal(12, 6)
  createdAt        DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("ai_usage")
}

model ConversationState {
  phone      String   @id
  pending    Json? // confirmação aguardando (ex: categoria a confirmar)
  history    Json     @default("[]") // últimas trocas (texto curto)
  // Última ação de registro (transação/parcelamento/lote): guarda os ids
  // criados e os dados de origem, para "cancela"/"refaz" operarem sobre a ação
  // inteira (N transações), não só a última transação única.
  lastAction Json?    @map("last_action")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("conversation_states")
}

// Idempotência do webhook do WhatsApp: cada mensagem entrante (messageId do
// WMode) é registrada aqui ao ser aceita para processamento. Antes era um Set em
// memória com TTL de 5min — que NÃO sobrevive a restart/redeploy nem é
// compartilhado entre instâncias, então um retry do WMode podia processar a mesma
// mensagem 2x (transação duplicada). A unicidade no banco torna o dedupe durável
// e atômico (insert falha → já processada). Limpeza periódica por createdAt.
model ProcessedMessage {
  messageId String   @id @map("message_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("processed_messages")
}
