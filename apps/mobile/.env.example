# URL da API NestJS (mesma que o web consome via NEXT_PUBLIC_API_URL).
# Em dev no simulador iOS, localhost funciona; no Android emulador use
# http://10.0.2.2:3001; em device físico use o IP da sua máquina na LAN.
# Variáveis EXPO_PUBLIC_* são embutidas no bundle e lidas via process.env.
EXPO_PUBLIC_API_URL=http://localhost:3001
