{
  "name": "lemonfin",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "mobile": "pnpm --filter mobile start",
    "mobile:fresh": "pnpm --filter mobile fresh",
    "mobile:apk": "pnpm --filter mobile run apk",
    "mobile:ios-device": "pnpm --filter mobile run ios:device",
    "mobile:build:ios": "pnpm --filter mobile run build:ios",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "prisma": "^6",
    "tsx": "^4",
    "turbo": "^2"
  },
  "dependencies": {
    "@prisma/client": "^6"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "lodash@<4.18.0": "^4.18.1",
      "fast-uri@<3.1.0": "^3.1.0",
      "typescript": "5.9.3"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "bcrypt",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
