# Database
#
# São DUAS variáveis (ver datasource em prisma/schema.prisma):
# - DATABASE_URL: usada pela app em runtime (via pooler em produção)
# - DIRECT_URL:  usada pelas migrations (prisma migrate/db push) — conexão DIRETA,
#                sem pooler. O PgBouncer em modo transaction não suporta migração.
#
# --- Dev local (docker-compose) — as duas apontam para o mesmo banco local ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/lemonfin
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/lemonfin
#
# --- Produção (Neon) ---
# DATABASE_URL: hostname COM POOLER (troque "<host>" por "<host>-pooler") + pool do Prisma:
#   DATABASE_URL="postgresql://USER:PASS@<host>-pooler.REGION.aws.neon.tech/DB?sslmode=require&connection_limit=20&pool_timeout=30&pgbouncer=true"
#   - connection_limit=20: mais conexões por instância (default do Prisma é só 10)
#   - pool_timeout=30: espera até 30s por uma conexão livre antes de falhar
#   - pgbouncer=true: obrigatório quando se usa o pooler do Neon
# DIRECT_URL: hostname SEM "-pooler" e sem os params de pooling:
#   DIRECT_URL="postgresql://USER:PASS@<host>.REGION.aws.neon.tech/DB?sslmode=require"

# Backend
API_PORT=3001
# OBRIGATÓRIO. Sem isto a API não sobe (não há fallback). Use um valor longo e
# aleatório, ex: `openssl rand -hex 32`.
JWT_SECRET=your-jwt-secret-here
# Opcional, mas RECOMENDADO: chave dedicada para cifrar o secret do 2FA (TOTP).
# Se ausente, usa o JWT_SECRET (compatível com secrets já gravados). Defina uma
# chave própria para que rotacionar o JWT não invalide o 2FA dos usuários.
# TOTP_ENCRYPTION_KEY=your-dedicated-totp-key-here

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here
AUTH_SECRET=your-nextauth-secret-here

# WhatsApp (WMode Connect)
WMODE_API_URL=https://your-wmode-url.ngrok-free.app
WMODE_API_KEY=wmc_your-api-key-here
WMODE_SESSION_ID=your-session-uuid-here
WMODE_WEBHOOK_SECRET=your-webhook-secret-here

# AI (OpenAI) — modelo em uso: gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key-here

# AI (Google Gemini) — legado, mantido como fallback
GEMINI_API_KEY=your-gemini-api-key-here

# Email (Resend) — confirmação de cadastro e reset de senha (OTP de 6 dígitos)
# RESEND_API_KEY: chave da API do Resend (https://resend.com/api-keys). Sem ela,
#   os e-mails NÃO são enviados (o código fica salvo no banco; ok p/ dev local).
# MAIL_FROM: remetente. Em produção, use um domínio verificado no Resend.
#   O onboarding@resend.dev funciona sem verificar, mas só envia p/ o e-mail da
#   sua própria conta Resend (modo teste).
RESEND_API_KEY=your-resend-api-key-here
MAIL_FROM=LemonFin <onboarding@resend.dev>
